<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="top" android:padding="18dp"
    android:background="@drawable/birikio_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="B✦  BU AYIN BÜTÇESİ" android:textColor="@color/widget_accent"
        android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="KALAN LİMİT"
        android:textColor="@color/widget_muted" android:textSize="10sp" />
    <TextView android:id="@+id/budget_remaining" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Limit belirle" android:textColor="@color/widget_text"
        android:textSize="24sp" android:textStyle="bold" android:maxLines="1"
        android:ellipsize="end" />
    <TextView android:id="@+id/budget_spent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="17dp"
        android:text="Harcanan 0,00 ₺" android:textColor="@color/widget_muted"
        android:textSize="12sp" />
    <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="BÜTÇE KULLANIMI" android:textColor="@color/widget_muted"
        android:textSize="10sp" />
    <TextView android:id="@+id/budget_percent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="—" android:textColor="@color/widget_accent"
        android:textSize="22sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/budget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp"
        android:layout_marginTop="8dp" android:max="100" android:progress="0"
        android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_track" />
</LinearLayout>
